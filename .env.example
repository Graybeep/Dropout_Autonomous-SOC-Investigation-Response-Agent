# Pick one provider and fill in its four lines. Both wire formats are supported.
# README "Setup" step 4 has a worked example of each.

# OpenAI-compatible endpoint (Authorization: Bearer)
SOC_API_KEY=sk-your-key-here
SOC_BASE_URL=https://api.openai.com/v1
SOC_MODEL=gpt-4o-mini
SOC_API_STYLE=openai

# Anthropic-compatible endpoint (x-api-key): comment out the four lines above
# and uncomment these instead.
# SOC_API_KEY=sk-ant-your-key-here
# SOC_BASE_URL=https://api.anthropic.com/v1
# SOC_MODEL=claude-sonnet-5
# SOC_API_STYLE=anthropic

# For the record: the committed traces were produced with
#   SOC_BASE_URL=https://router.bynara.id/v1
#   SOC_MODEL=ling-3.0-flash-fin-free
# That gateway retired the model on or before 14 September 2026, so it no longer
# works and is kept here only as a record of where the traces came from.

SOC_MIN_INTERVAL=3.0
SOC_RETRY_MAX=5
SOC_RETRY_BASE=15.0
